---
interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-20">

<h2 class="text-5xl font-extrabold">

Pros & Cons

</h2>

<div class="mt-12 grid gap-10 lg:grid-cols-2">

<div class="rounded-3xl border border-green-200 bg-green-50 p-8">

<h3 class="text-3xl font-bold text-green-700">

✅ Pros

</h3>

<ul class="mt-8 space-y-4">

{
pros.map((pro) => (
<li class="flex items-start gap-3">
<span class="text-green-600">✔</span>
<span>{pro}</span>
</li>
))
}

</ul>

</div>

<div class="rounded-3xl border border-red-200 bg-red-50 p-8">

<h3 class="text-3xl font-bold text-red-700">

❌ Cons

</h3>

<ul class="mt-8 space-y-4">

{
cons.map((con) => (
<li class="flex items-start gap-3">
<span class="text-red-600">✖</span>
<span>{con}</span>
</li>
))
}

</ul>

</div>

</div>

</section>