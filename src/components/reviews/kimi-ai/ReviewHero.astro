---
interface Props{
title:string;
subtitle:string;
rating:number;
logo:string;
category:string;
}

const{
title,
subtitle,
rating,
logo,
category
}=Astro.props;
---

<section class="bg-gradient-to-r from-blue-600 to-purple-700 py-24 text-white">

<div class="mx-auto max-w-6xl px-6">

<div class="flex flex-col items-center text-center">

<img
src={logo}
alt={title}
class="h-28 w-28 rounded-3xl bg-white p-4 shadow-xl"
/>

<span class="mt-8 rounded-full bg-white/20 px-5 py-2 font-semibold">

{category}

</span>

<h1 class="mt-8 text-6xl font-extrabold">

{title}

</h1>

<p class="mt-8 max-w-3xl text-xl leading-9 text-blue-100">

{subtitle}

</p>

<div class="mt-10 rounded-full bg-yellow-400 px-6 py-3 font-bold text-black">

⭐ {rating}/5

</div>

</div>

</div>

</section>