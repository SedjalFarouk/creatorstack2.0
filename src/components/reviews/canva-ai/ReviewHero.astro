---
interface Props {
  title: string;
  description: string;
  category: string;
  rating: number;
  logo: string;
}

const { title, description, category, rating, logo } = Astro.props;
---

<section class="bg-gradient-to-b from-blue-50 to-white py-20">

<div class="mx-auto max-w-7xl px-6">

<div class="grid items-center gap-12 lg:grid-cols-2">

<div>

<span class="rounded-full bg-blue-100 px-4 py-2 text-sm font-semibold text-blue-700">
{category}
</span>

<h1 class="mt-6 text-5xl font-extrabold">
{title}
</h1>

<p class="mt-8 text-xl leading-9 text-gray-600">
{description}
</p>

<div class="mt-8 flex items-center gap-6">

<div class="text-4xl font-bold text-blue-600">
⭐ {rating}/5
</div>

<div class="rounded-full bg-green-100 px-4 py-2 text-green-700 font-semibold">
Editor's Choice 2026
</div>

</div>

<div class="mt-6 flex flex-wrap gap-4">

<a
href="#pricing"
class="rounded-xl border px-6 py-3 font-semibold hover:bg-gray-100"
>

💰 Pricing

</a>

<a
href="#verdict"
class="rounded-xl border px-6 py-3 font-semibold hover:bg-gray-100"
>

🏆 Final Verdict

</a>

<a
href="#faq"
class="rounded-xl border px-6 py-3 font-semibold hover:bg-gray-100"
>

❓ FAQ

</a>

</div>

<a
href="#pricing"
class="mt-10 inline-flex rounded-2xl bg-blue-600 px-8 py-4 font-bold text-white transition hover:bg-blue-700"
>

🚀 Get Canva Pro

</a>

</div>

<div class="flex justify-center">

<img
src={logo}
alt="Canva AI"
class="w-72 rounded-3xl shadow-2xl"
/>

</div>

</div>

</div>

</section>