---
import { affiliateLinks } from "../../data/affiliateLinks";
---

<section class="mx-auto max-w-5xl px-6 py-10">

<div class="rounded-3xl border-2 border-blue-600 bg-blue-50 p-8 shadow-lg">

<div class="flex items-center gap-3">

<div class="text-4xl">🏆</div>

<div>

<h2 class="text-3xl font-bold">
Why We Recommend VEED
</h2>

<p class="text-gray-600">
Our Editor's Choice for AI Video Editing
</p>

</div>

</div>

<ul class="mt-8 space-y-4 text-lg">

<li>✅ Extremely beginner friendly</li>

<li>✅ Excellent AI subtitle generation</li>

<li>✅ Browser-based (no installation)</li>

<li>✅ Professional export quality</li>

<li>✅ Fantastic for YouTube & TikTok creators</li>

<li>✅ Great value for money</li>

</ul>

<div class="mt-8 rounded-2xl border border-green-300 bg-green-50 p-6">

<h3 class="text-2xl font-bold text-green-800">

🎉 Exclusive CreatorStack Offer

</h3>

<p class="mt-3 text-green-700">

Get <strong>50% OFF your first 3 months</strong> by signing up through our exclusive partner link.

</p>

<p class="mt-2 text-sm text-green-600">

Available on eligible VEED subscriptions.

</p>

</div>

<a

href={affiliateLinks.veed}

target="_blank"

rel="nofollow sponsored noopener"

onclick="trackAffiliateClick('VEED','Recommendation Box')"

class="mt-8 inline-flex rounded-2xl bg-green-600 px-8 py-4 text-lg font-bold text-white transition hover:bg-green-700"

>

🚀 Claim Your 50% Discount

</a>

</div>

</section>