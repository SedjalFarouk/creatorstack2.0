---
const {
  sections,
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-20">

<h2 class="text-center text-5xl font-extrabold">
Detailed Comparison
</h2>

<div class="mt-16 space-y-16">

{
sections.map((section:any)=>(

<div class="rounded-3xl border bg-white p-10 shadow-sm">

<h3 class="text-3xl font-bold">

{section.title}

</h3>

<div class="mt-10 grid gap-10 md:grid-cols-2">

<div>

<h4 class="text-2xl font-bold text-blue-600">

{section.leftTitle}

</h4>

<p class="mt-4 leading-8 text-gray-600">

{section.leftText}

</p>

</div>

<div>

<h4 class="text-2xl font-bold text-purple-600">

{section.rightTitle}

</h4>

<p class="mt-4 leading-8 text-gray-600">

{section.rightText}

</p>

</div>

</div>

</div>

))
}

</div>

</section>