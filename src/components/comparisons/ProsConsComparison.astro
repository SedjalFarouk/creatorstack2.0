---
const {
  leftTitle,
  rightTitle,
  leftPros,
  leftCons,
  rightPros,
  rightCons,
} = Astro.props;
---

<section class="mx-auto max-w-7xl px-6 py-20">

<h2 class="mb-12 text-center text-5xl font-extrabold">
Pros & Cons
</h2>

<div class="grid gap-10 lg:grid-cols-2">

<div class="rounded-3xl border bg-white p-10 shadow-sm">

<h3 class="text-3xl font-bold text-blue-600">
{leftTitle}
</h3>

<h4 class="mt-8 text-xl font-bold text-green-600">
Pros
</h4>

<ul class="mt-4 space-y-3">
{
leftPros.map((item:string)=>(
<li>✅ {item}</li>
))
}
</ul>

<h4 class="mt-10 text-xl font-bold text-red-600">
Cons
</h4>

<ul class="mt-4 space-y-3">
{
leftCons.map((item:string)=>(
<li>❌ {item}</li>
))
}
</ul>

</div>

<div class="rounded-3xl border bg-white p-10 shadow-sm">

<h3 class="text-3xl font-bold text-purple-600">
{rightTitle}
</h3>

<h4 class="mt-8 text-xl font-bold text-green-600">
Pros
</h4>

<ul class="mt-4 space-y-3">
{
rightPros.map((item:string)=>(
<li>✅ {item}</li>
))
}
</ul>

<h4 class="mt-10 text-xl font-bold text-red-600">
Cons
</h4>

<ul class="mt-4 space-y-3">
{
rightCons.map((item:string)=>(
<li>❌ {item}</li>
))
}
</ul>

</div>

</div>

</section>