---
interface Props {
  title: string;
  subtitle: string;

  leftName: string;
  leftLogo: string;
  leftRating: number;

  rightName: string;
  rightLogo: string;
  rightRating: number;

  winner: string;
  updated: string;
  readTime: string;
}

const {
  title,
  subtitle,

  leftName,
  leftLogo,
  leftRating,

  rightName,
  rightLogo,
  rightRating,

  winner,
  updated,
  readTime,
} = Astro.props;
---

<section class="bg-gradient-to-r from-blue-600 via-blue-700 to-purple-700 py-24 text-white">

  <div class="mx-auto max-w-7xl px-6">

    <div class="text-center">

      <span class="rounded-full bg-white/20 px-5 py-2 text-sm font-bold">
        ⚖️ AI Tool Comparison
      </span>

      <h1 class="mt-8 text-5xl font-extrabold lg:text-6xl">
        {title}
      </h1>

      <p class="mx-auto mt-8 max-w-4xl text-xl leading-9 text-blue-100">
        {subtitle}
      </p>

    </div>

    <div class="mt-20 grid items-center gap-10 lg:grid-cols-3">

      <!-- Canva -->

      <div class="rounded-3xl bg-white p-8 text-center text-gray-900 shadow-2xl">

        <img
          src={leftLogo}
          alt={leftName}
          class="mx-auto h-24 w-24 object-contain"
        />

        <h2 class="mt-6 text-3xl font-bold">
          {leftName}
        </h2>

        <p class="mt-4 text-4xl text-yellow-500">
          ⭐⭐⭐⭐⭐
        </p>

        <p class="mt-3 text-lg font-semibold">
          {leftRating}/5
        </p>

      </div>

      <!-- Winner -->

      <div class="text-center">

        <div class="text-6xl font-extrabold">
          VS
        </div>

        <div class="mt-8 rounded-3xl bg-green-500 px-8 py-6 shadow-2xl">

          <p class="text-lg font-semibold">
            🏆 WINNER
          </p>

          <p class="mt-3 text-3xl font-extrabold">
            {winner}
          </p>

        </div>

        <div class="mt-8 flex justify-center gap-6 text-sm text-blue-100">

          <span>
            📅 {updated}
          </span>

          <span>
            ⏱ {readTime}
          </span>

        </div>

      </div>

      <!-- Adobe -->

      <div class="rounded-3xl bg-white p-8 text-center text-gray-900 shadow-2xl">

        <img
          src={rightLogo}
          alt={rightName}
          class="mx-auto h-24 w-24 object-contain"
        />

        <h2 class="mt-6 text-3xl font-bold">
          {rightName}
        </h2>

        <p class="mt-4 text-4xl text-yellow-500">
          ⭐⭐⭐⭐☆
        </p>

        <p class="mt-3 text-lg font-semibold">
          {rightRating}/5
        </p>

      </div>

    </div>

  </div>

</section>