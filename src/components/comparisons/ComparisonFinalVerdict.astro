---
const {
  winner,
  verdict,
  ctaText,
  ctaLink,
} = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-24">

<div class="rounded-3xl bg-gradient-to-r from-blue-600 to-purple-700 p-14 text-center text-white">

<span class="rounded-full bg-white/20 px-5 py-2 font-bold">

🏆 Winner

</span>

<h2 class="mt-8 text-5xl font-extrabold">

{winner}

</h2>

<p class="mx-auto mt-8 max-w-3xl text-xl leading-9 text-blue-100">

{verdict}

</p>

<a
href={ctaLink}
target="_blank"
rel="nofollow sponsored noopener"
class="mt-10 inline-flex rounded-2xl bg-white px-10 py-5 text-xl font-bold text-blue-700 transition hover:scale-105"
>

{ctaText}

</a>

<p class="mt-6 text-blue-100">

Free plan available • No credit card required

</p>

</div>

</section>