---
import MainLayout from "../layouts/MainLayout.astro";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrendingTools from "../components/TrendingTools.astro";
import Categories from "../components/Categories.astro";
import FeaturedTools from "../components/FeaturedTools.astro";
import WhyTrust from "../components/WhyTrust.astro";
import LatestReviews from "../components/LatestReviews.astro";
import PopularComparisons from "../components/PopularComparisons.astro";
import Newsletter from "../components/Newsletter.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout
title="CreatorStack | Discover the Best AI Tools"
description="Expert reviews, comparisons and buying guides for AI tools, software and creator products."
canonical="https://creatorstack2-0.pages.dev/"
image="/images/og/home.jpg"
>

  <Header />

  <Hero />

  <TrendingTools />

  <Categories />

  <section class="mx-auto max-w-7xl px-6 py-20">

<div class="rounded-3xl bg-gradient-to-r from-blue-600 to-purple-700 p-12 text-center text-white">

<span class="rounded-full bg-white/20 px-5 py-2 font-semibold">

🔥 Most Popular Guide

</span>

<h2 class="mt-6 text-5xl font-extrabold">

25 Best AI Tools of 2026

</h2>

<p class="mx-auto mt-6 max-w-3xl text-xl leading-9 text-blue-100">

Looking for the best AI software?

We've personally tested the top AI tools for writing,
design, video editing, marketing and productivity.

</p>

<a
href="/best-ai-tools-2026"
class="mt-10 inline-flex rounded-2xl bg-white px-10 py-5 text-xl font-bold text-blue-700 transition hover:scale-105">

Explore the Guide →

</a>

</div>

</section>

  <FeaturedTools />

  <WhyTrust />

  <LatestReviews />

  <PopularComparisons />

  <Newsletter />

  <Footer />

</MainLayout>