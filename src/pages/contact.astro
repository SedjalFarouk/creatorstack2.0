---
import MainLayout from "../layouts/MainLayout.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout
title="Contact CreatorStack"
description="Contact CreatorStack for business inquiries, partnerships, feedback or questions."
canonical="https://creatorstack2-0.pages.dev/contact"
>

<!-- HERO -->

<section class="bg-gradient-to-r from-blue-600 to-purple-700 py-28 text-white">

<div class="mx-auto max-w-5xl px-6 text-center">

<span class="rounded-full bg-white/20 px-5 py-2 font-semibold">

📩 Contact Us

</span>

<h1 class="mt-8 text-6xl font-extrabold">

Let's Get In Touch

</h1>

<p class="mx-auto mt-8 max-w-3xl text-2xl leading-10 text-blue-100">

Questions, partnership opportunities or feedback?

We'd love to hear from you.

</p>

</div>

</section>

<!-- CONTACT OPTIONS -->

<section class="mx-auto max-w-7xl px-6 py-24">

<div class="grid gap-8 md:grid-cols-3">

<div class="rounded-3xl border bg-white p-10 shadow">

<div class="text-5xl">

📧

</div>

<h2 class="mt-6 text-2xl font-bold">

Email

</h2>

<p class="mt-4 text-gray-600">

For general questions or support.

</p>

<p class="mt-8 font-bold text-blue-600">

contact@creatorstack.com

</p>

</div>

<div class="rounded-3xl border bg-white p-10 shadow">

<div class="text-5xl">

🤝

</div>

<h2 class="mt-6 text-2xl font-bold">

Partnerships

</h2>

<p class="mt-4 text-gray-600">

Interested in working with CreatorStack?

Let's discuss sponsorships, collaborations or product reviews.

</p>

</div>

<div class="rounded-3xl border bg-white p-10 shadow">

<div class="text-5xl">

💡

</div>

<h2 class="mt-6 text-2xl font-bold">

Feedback

</h2>

<p class="mt-4 text-gray-600">

Found an error?

Want us to review an AI tool?

We're always looking for suggestions.

</p>

</div>

</div>

</section>

<!-- FAQ -->

<section class="bg-gray-50 py-24">

<div class="mx-auto max-w-5xl px-6">

<h2 class="text-center text-5xl font-extrabold">

Frequently Asked Questions

</h2>

<div class="mt-16 space-y-8">

<div class="rounded-3xl bg-white p-8 shadow">

<h3 class="text-2xl font-bold">

Can I request an AI tool review?

</h3>

<p class="mt-4 text-gray-700">

Absolutely. We're always looking for new AI software to test and review.

</p>

</div>

<div class="rounded-3xl bg-white p-8 shadow">

<h3 class="text-2xl font-bold">

Do you accept sponsored reviews?

</h3>

<p class="mt-4 text-gray-700">

We may accept sponsored collaborations, but sponsorship never guarantees a positive review. Our opinions remain independent.

</p>

</div>

<div class="rounded-3xl bg-white p-8 shadow">

<h3 class="text-2xl font-bold">

How quickly do you respond?

</h3>

<p class="mt-4 text-gray-700">

We aim to respond to all genuine inquiries within 2–3 business days.

</p>

</div>

</div>

</div>

</section>

<!-- CTA -->

<section class="bg-gradient-to-r from-blue-600 to-purple-700 py-24 text-white">

<div class="mx-auto max-w-5xl px-6 text-center">

<h2 class="text-5xl font-extrabold">

Thank You For Visiting CreatorStack

</h2>

<p class="mx-auto mt-8 max-w-3xl text-2xl leading-10 text-blue-100">

We appreciate every visitor and every piece of feedback.

Our goal is to help people find the best AI tools with honest, transparent reviews.

</p>

<a
href="/best-ai-tools-2026"
class="mt-10 inline-flex rounded-2xl bg-white px-10 py-5 text-xl font-bold text-blue-700 transition hover:scale-105">

🏆 Explore Our Reviews

</a>

</div>

</section>

<Footer />

</MainLayout>