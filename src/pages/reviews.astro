---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReviewCard from "../components/ReviewCard.astro";
---

<MainLayout title="AI Tool Reviews | CreatorStack">

<Header />

<section class="mx-auto max-w-7xl px-6 py-20">

  <div class="mb-14 text-center">

    <h1 class="text-5xl font-extrabold">
      AI Tool Reviews
    </h1>

    <p class="mx-auto mt-6 max-w-3xl text-xl text-gray-600">
      Honest, in-depth reviews of the best AI tools for creators,
      marketers, developers and businesses.
    </p>

  </div>

  <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">

    <ReviewCard
      title="VEED"
      description="AI Video Editor with subtitles, avatars and online editing."
      category="AI Video"
      rating={4.8}
      href="/reviews/veed"
      logo="/images/tools/veed.png"
    />

    <ReviewCard
      title="ChatGPT"
      description="The world's most popular AI assistant."
      category="AI Chatbot"
      rating={4.9}
      href="/reviews/chatgpt"
      logo="/images/tools/chatgpt.png"
    />

    <ReviewCard
      title="Canva AI"
      description="Design graphics using AI."
      category="Design"
      rating={4.8}
      href="/reviews/canva-ai"
      logo="/images/tools/canva.png"
    />

    <ReviewCard
      title="ElevenLabs"
      description="Industry-leading AI voice generation."
      category="AI Audio"
      rating={4.9}
      href="/reviews/elevenlabs"
      logo="/images/tools/elevenlabs.png"
    />

    <ReviewCard
      title="Claude"
      description="Powerful AI assistant from Anthropic."
      category="AI Chatbot"
      rating={4.8}
      href="/reviews/claude"
      logo="/images/tools/claude.png"
    />

    <ReviewCard
      title="Grammarly"
      description="AI writing assistant for professionals."
      category="Writing"
      rating={4.7}
      href="/reviews/grammarly"
      logo="/images/tools/grammarly.png"
    />

    <a
  href="/reviews/kimi-ai"
  class="group block overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-lg transition duration-300 hover:-translate-y-3 hover:shadow-2xl"
>

  <div class="p-8">

    <div class="flex items-center justify-between">

      <img
        src="/images/tools/kimi.png"
        alt="Kimi AI"
        class="h-16 w-16 rounded-2xl object-contain"
      />

      <div class="rounded-full bg-yellow-100 px-3 py-2 text-sm font-bold text-yellow-700">

        ⭐ 4.9

      </div>

    </div>

    <h3 class="mt-8 text-2xl font-bold group-hover:text-blue-600">

      Kimi AI

    </h3>

    <p class="mt-4 leading-8 text-gray-600">

      Our complete hands-on review of Kimi AI, covering reasoning, coding, long-context understanding, pricing, strengths, weaknesses, and whether it's worth using in 2026.

    </p>

    <div class="mt-8 flex items-center justify-between">

      <span class="font-bold text-blue-600">

        Free

      </span>

      <span class="font-semibold">

        Read Review →

      </span>

    </div>

  </div>

</a>

  </div>

</section>

<Footer />

</MainLayout>